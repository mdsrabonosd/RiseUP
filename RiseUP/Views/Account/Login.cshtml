@model RiseUp.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg p-4">
            <h3 class="fw-bold text-center mb-3">Welcome Back</h3>
            <p class="text-muted text-center mb-4">Log in to access your dashboard and ecosystem</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label" asp-for="RememberMe"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Log in</button>
            </form>
        </div>
    </div>
</div>