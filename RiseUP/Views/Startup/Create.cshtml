@model RiseUp.Models.StartupIdea
@{
    ViewData["Title"] = "Post a Startup Idea";
}

<!-- Optional: Ensure Bootstrap Icons are included in your _Layout.cshtml -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="row justify-content-center my-4">
    <!-- Reduced column width from col-lg-8 to col-lg-6 for a tighter layout -->
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <!-- Header Banner (Compact Padding) -->
            <div class="bg-primary bg-gradient text-white p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-rocket-takeoff fs-5"></i>
                    <h5 class="fw-bold mb-0">Publish Your Pitch</h5>
                </div>
                <p class="text-white-50 small mb-0">Connect your startup idea with investors and mentors.</p>
            </div>

            <!-- Form Body (Compact Padding & Spacing) -->
            <div class="card-body p-3 p-md-4 bg-white">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-dark small">Startup Title</label>
                        <input asp-for="Title" class="form-control form-control-sm rounded-2" />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Tagline -->
                    <div class="mb-3">
                        <label asp-for="Tagline" class="form-label fw-semibold text-dark small">Tagline</label>
                        <input asp-for="Tagline" class="form-control form-control-sm rounded-2" />
                        <span asp-validation-for="Tagline" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Category & Funding Goal -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="Category" class="form-label fw-semibold text-dark small">Category</label>
                            <select asp-for="Category" class="form-select form-select-sm rounded-2">
                                <option value="" disabled selected>Select category...</option>
                                <option value="AI">AI & Machine Learning</option>
                                <option value="Fintech">Fintech</option>
                                <option value="EdTech">EdTech</option>
                                <option value="HealthTech">HealthTech</option>
                                <option value="Cybersecurity">Cybersecurity</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="FundingGoal" class="form-label fw-semibold text-dark small">Funding Goal</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted">$</span>
                                <input asp-for="FundingGoal" class="form-control rounded-end-2" />
                            </div>
                            <span asp-validation-for="FundingGoal" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Pitch Deck Link -->
                    <div class="mb-3">
                        <label asp-for="PitchDeckUrl" class="form-label fw-semibold text-dark small">
                            Pitch Deck Link <span class="text-muted fw-normal">(Optional)</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-link-45deg"></i>
                            </span>
                            <input asp-for="PitchDeckUrl" class="form-control rounded-end-2" />
                        </div>
                        <span asp-validation-for="PitchDeckUrl" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Detailed Pitch Description -->
                    <div class="mb-3">
                        <label asp-for="DetailedDescription" class="form-label fw-semibold text-dark small">Detailed Pitch</label>
                        <textarea asp-for="DetailedDescription" class="form-control form-control-sm rounded-2" rows="3"></textarea>
                        <span asp-validation-for="DetailedDescription" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <hr class="my-3 text-muted opacity-25" />

                    <!-- Form Actions -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light text-secondary fw-semibold px-3">Cancel</a>
                        <button type="submit" class="btn btn-sm btn-primary fw-bold px-3">
                            <i class="bi bi-send me-1"></i> Publish
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}





