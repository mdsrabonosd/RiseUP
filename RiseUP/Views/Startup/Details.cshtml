@model RiseUp.Models.StartupIdea
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row">
        <!-- Main Pitch Content -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary fs-6">@Model.Category</span>
                    <span class="text-muted small">@Model.ViewsCount Views</span>
                </div>
                <h1 class="fw-bold display-6">@Model.Title</h1>
                <p class="lead text-muted">@Model.Tagline</p>
                <hr />
                <h5 class="fw-bold mb-3">About the Startup</h5>
                <p style="white-space: pre-line;">@Model.DetailedDescription</p>

                @if (!string.IsNullOrEmpty(Model.PitchDeckUrl))
                {
                    <div class="mt-4">
                        <a href="@Model.PitchDeckUrl" target="_blank" class="btn btn-outline-primary fw-semibold">
                            📄 View Full Pitch Deck / Link
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Details -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h5 class="fw-bold mb-3">Funding Target</h5>
                <h2 class="text-success fw-bold">$@Model.FundingGoal.ToString("N0")</h2>
                <hr />
                <h6 class="fw-semibold">Founder Info</h6>
                <p class="mb-1 fw-bold">@(Model.Founder?.FullName ?? "Anonymous Founder")</p>
                <p class="text-muted small">@Model.Founder?.Email</p>

                <hr />
                <a href="#" class="btn btn-primary w-100 mb-2 fw-semibold">💬 Send Message</a>
                <a href="#" class="btn btn-outline-success w-100 fw-semibold">🤝 Express Interest</a>
            </div>
        </div>
    </div>
</div>